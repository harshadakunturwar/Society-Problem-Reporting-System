<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Society Problem Reporting System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <h1>SocietyCare - Problem Reporting System</h1>
        <p>Centralized platform for housing society complaint management & priority tracking</p>
    </header>

    <main class="container">
        <section class="form-section">
            <h2>Report a New Issue</h2>
            <form id="complaintForm">
                <div class="form-group">
                    <label for="category">Category:</label>
                    <select id="category" required>
                        <option value="">Select Category</option>
                        <option value="Water Leakage">Water Leakage</option>
                        <option value="Lift Problem">Lift Problem</option>
                        <option value="Streetlight">Streetlight</option>
                        <option value="Garbage">Garbage</option>
                        <option value="Security">Security</option>
                        <option value="Maintenance">Maintenance</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" rows="3" placeholder="Describe the issue in detail..." required></textarea>
                </div>
                <button type="submit" class="btn-submit">Submit Complaint</button>
            </form>
        </section>

        <section class="list-section">
            <h2>Reported Issues (Sorted by Priority)</h2>
            <div id="complaintsContainer">
                <!-- Complaints will load dynamically here -->
            </div>
        </section>
    </main>

    <script src="script.js"></script>
</body>
</html>
